# Puerto del backend usado por el proxy de Vite.
PORT=5000

# URI de MongoDB. Para MongoDB Atlas, asegúrate de que tu IP actual esté
# permitida en Network Access > IP Access List y que el usuario/password sean correctos.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Secreto para firmar JWT. Usa un valor largo y privado en entornos reales.
JWT_SECRET=change-me

# Opcional: reduce o aumenta cuánto espera Mongoose antes de declarar caída la conexión.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Frontend público usado para construir el link de verificación de email.
FRONTEND_URL=http://localhost:5173

# SMTP para enviar emails reales de verificación. Puedes usar SendGrid, Mailgun,
# AWS SES, Gmail SMTP u otro proveedor que entregue host/puerto/usuario/password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Project Manager
